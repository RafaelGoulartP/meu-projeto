@layouts.painel()
    <section class="w-full max-w-5xl mx-auto pb-12" aria-labelledby="titulo-criar-curso">
        <a href="/meusCursos" class="inline-flex items-center gap-2 text-sm font-semibold text-slate-600 hover:text-slate-900">
            <span aria-hidden="true">←</span> Voltar para meus cursos
        </a>

        <div class="mt-7 mb-8">
            <p class="text-xs font-semibold tracking-widest text-slate-500 uppercase">Seu próximo curso começa aqui</p>
            <h2 id="titulo-criar-curso" class="mt-2 text-3xl font-semibold tracking-tight text-slate-900">Criar curso</h2>
            <p class="mt-3 text-sm text-slate-600">Dê um nome à sua ideia, conte o que será ensinado e escolha uma capa.</p>
        </div>

        <form method="POST" action="/cursos" enctype="multipart/form-data" class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm" aria-label="Dados do novo curso">
            {{ csrfField() }}
            <div class="grid gap-8 p-6 md:p-8 xl:grid-cols-5 xl:gap-10">
                <div class="xl:col-span-3">
                    <div class="flex items-center gap-3 mb-7">
                        <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-[#edf5e5] text-sm font-semibold text-[#526e38]" aria-hidden="true">01</span>
                        <h3 class="font-semibold text-slate-900">Informações do curso</h3>
                    </div>

                    <div>
                        <label for="nome" class="block text-sm font-semibold text-slate-800">Nome do curso</label>
                        <input
                            type="text"
                            id="nome"
                            name="nome"
                            value="{{ old('nome') || '' }}"
                            required
                            minlength="3"
                            maxlength="255"
                            placeholder="Ex.: HTML e CSS do zero"
                            aria-describedby="ajuda-nome"
                            class="mt-2 w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm text-slate-900 placeholder:text-slate-400 focus:border-[#7f9b60] focus:outline-2 focus:outline-[#d9efb5]"
                        >
                        <p id="ajuda-nome" class="mt-2 text-xs leading-relaxed text-slate-500">Escolha um título claro que apresente o assunto do curso.</p>
                        @if(flashMessages.has('inputErrorsBag.nome'))
                            <p class="mt-2 text-sm text-red-700" role="alert">{{ flashMessages.get('inputErrorsBag.nome')[0] }}</p>
                        @end
                    </div>

                    <div class="mt-7">
                        <label for="descricao" class="block text-sm font-semibold text-slate-800">Descrição</label>
                        <textarea
                            id="descricao"
                            name="descricao"
                            required
                            minlength="10"
                            maxlength="5000"
                            rows="7"
                            placeholder="O que os alunos vão aprender? Para quem é este curso?"
                            aria-describedby="ajuda-descricao"
                            class="mt-2 w-full resize-y rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm leading-relaxed text-slate-900 placeholder:text-slate-400 focus:border-[#7f9b60] focus:outline-2 focus:outline-[#d9efb5]"
                        >{{ old('descricao') || '' }}</textarea>
                        <p id="ajuda-descricao" class="mt-2 text-xs leading-relaxed text-slate-500">Apresente o conteúdo e os conhecimentos que o aluno poderá desenvolver.</p>
                        @if(flashMessages.has('inputErrorsBag.descricao'))
                            <p class="mt-2 text-sm text-red-700" role="alert">{{ flashMessages.get('inputErrorsBag.descricao')[0] }}</p>
                        @end
                    </div>
                </div>

                <div class="xl:col-span-2">
                    <div class="flex items-center gap-3 mb-7">
                        <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-[#edf5e5] text-sm font-semibold text-[#526e38]" aria-hidden="true">02</span>
                        <h3 class="font-semibold text-slate-900">Capa do curso</h3>
                    </div>

                    <label for="capa" class="block cursor-pointer rounded-xl border border-dashed border-[#a5b791] bg-[#f7f9f3] px-5 py-9 text-center hover:bg-[#eff4e7]">
                        <span class="mx-auto flex h-12 w-12 items-center justify-center rounded-xl bg-[#e5edda] text-2xl text-[#526e38]" aria-hidden="true">↑</span>
                        <span class="mt-4 block text-sm font-semibold text-slate-800">Escolha uma imagem de capa</span>
                        <span class="mt-2 block text-xs leading-relaxed text-slate-500">Uma boa capa ajuda a apresentar o seu curso.</span>
                    </label>

                    <input
                        type="file"
                        id="capa"
                        name="capa"
                        required
                        accept="image/jpeg,image/png,image/webp"
                        aria-describedby="ajuda-capa"
                        class="mt-4 block w-full rounded-lg text-xs text-slate-600 file:mr-3 file:cursor-pointer file:rounded-lg file:border-0 file:bg-zinc-100 file:px-3 file:py-2 file:font-semibold file:text-zinc-800 hover:file:bg-zinc-200 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#7f9b60]"
                    >
                    <p id="ajuda-capa" class="mt-3 text-xs leading-relaxed text-slate-500">JPG, PNG ou WebP, até 5 MB. Prefira uma imagem horizontal na proporção 16:9.</p>
                    @if(flashMessages.has('inputErrorsBag.capa'))
                        <p class="mt-2 text-sm text-red-700" role="alert">{{ flashMessages.get('inputErrorsBag.capa')[0] }} Selecione a imagem novamente para enviar.</p>
                    @end

                    <aside class="mt-6 rounded-xl bg-[#f4f2ee] p-4" aria-label="Dica para a capa">
                        <h4 class="text-xs font-semibold text-slate-800">Uma dica para começar</h4>
                        <p class="mt-2 text-xs leading-relaxed text-slate-600">Use uma imagem que combine com o tema e evite textos pequenos, para que a capa fique legível também no celular.</p>
                    </aside>
                </div>
            </div>

            <div class="flex flex-col-reverse gap-3 border-t border-slate-100 bg-[#fcfcfa] p-6 sm:flex-row sm:justify-end md:px-8">
                <a href="/meusCursos" class="inline-flex items-center justify-center rounded-xl border border-slate-300 px-5 py-3 text-sm font-semibold text-slate-600 hover:bg-slate-100">Cancelar</a>
                <button type="submit" class="inline-flex cursor-pointer items-center justify-center rounded-xl bg-[#d9efb5] px-6 py-3 text-sm font-semibold text-[#354b26] hover:bg-[#c6e59a] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#7f9b60]">Criar curso</button>
            </div>
        </form>
    </section>
@end
