@layouts.painel()
    <section class="w-full max-w-5xl mx-auto pb-12" aria-labelledby="titulo-curso">
        <a href="{{ responsavel ? '/meusCursos' : '/dashboard' }}" class="inline-flex items-center gap-2 text-sm font-semibold text-slate-600 hover:text-slate-900">
            <span aria-hidden="true">←</span> {{ responsavel ? 'Voltar para meus cursos' : 'Voltar para inscrições' }}
        </a>

        <article class="mt-7 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
            <div class="grid lg:grid-cols-2">
                <div class="bg-zinc-900">
                    @if(curso.caminhoCapa)
                        <img src="{{ curso.caminhoCapa }}" alt="Capa do curso {{ curso.name }}" class="aspect-video w-full object-cover lg:h-full">
                    @else
                        <div class="flex aspect-video h-full items-center justify-center p-8 text-sm font-semibold text-zinc-300">Curso sem imagem de capa</div>
                    @end
                </div>
                <div class="p-6 md:p-8">
                    <p class="text-xs font-semibold uppercase tracking-widest text-[#657c4b]">{{ responsavel ? 'Meu curso' : 'Curso' }} <span aria-hidden="true">/</span> #{{ curso.id }}</p>
                    <h2 id="titulo-curso" class="mt-3 text-3xl font-semibold tracking-tight break-words text-slate-900">{{ curso.name }}</h2>
                    <p class="mt-3 text-sm text-slate-500">Por {{ curso.responsavel?.fullName || 'Autor não informado' }}</p>
                    <div class="mt-6 border-t border-slate-100 pt-5">
                        <h3 class="text-sm font-semibold text-slate-800">Sobre o curso</h3>
                        <p class="mt-3 whitespace-pre-line break-words text-sm leading-relaxed text-slate-600">{{ curso.descricao || 'Este curso ainda não possui descrição.' }}</p>
                    </div>
                    @if(!responsavel)
                        @if(podeAssistir)
                            <p class="mt-6 text-sm font-semibold text-[#526e38]">Você está inscrito neste curso.</p>
                        @else
                            <form method="POST" action="/cursos/{{ curso.id }}/inscricoes" class="mt-6">
                                {{ csrfField() }}
                                <button type="submit" class="cursor-pointer rounded-xl bg-[#d9efb5] px-6 py-3 text-sm font-semibold text-[#354b26] hover:bg-[#c6e59a]">Inscrever-me</button>
                            </form>
                        @end
                    @end
                </div>
            </div>
        </article>

        <section class="mt-9 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm" aria-labelledby="titulo-videos">
            <div class="flex flex-wrap items-center justify-between gap-4 border-b border-slate-100 p-6 md:px-8">
                <div>
                    <div class="flex flex-wrap items-center gap-3">
                        <h3 id="titulo-videos" class="text-lg font-semibold text-slate-900">Vídeos do curso</h3>
                        <span class="rounded-md bg-[#edf5e5] px-2 py-1 text-xs font-medium text-[#526e38]">{{ curso.videos.length }} vídeos</span>
                    </div>
                    <p class="mt-2 text-sm text-slate-500">{{ responsavel ? 'Organize os conteúdos do seu curso.' : (podeAssistir ? 'Escolha uma aula para começar a aprender.' : 'Conheça as aulas. Inscreva-se para assistir.') }}</p>
                </div>
                <button type="button" disabled class="rounded-xl bg-zinc-100 px-4 py-3 text-sm text-zinc-500">Adicionar vídeo · em breve</button>
            </div>

            <ol class="divide-y divide-slate-100">
                @each(video in curso.videos)
                    <li>
                        @if(podeAssistir)
                            <a href="/cursos/{{ curso.id }}/videos/{{ video.id }}" class="flex items-center gap-4 p-6 hover:bg-slate-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-zinc-900 md:px-8">
                        @else
                            <div class="flex items-center gap-4 p-6 md:px-8">
                        @end
                            <span class="flex h-14 w-20 shrink-0 items-center justify-center rounded-lg bg-[#e5edda] text-xl text-[#526e38]" aria-hidden="true">▷</span>
                            <div class="min-w-0 flex-1">
                                <h4 class="break-words text-sm font-semibold text-slate-900">{{ video.name }}</h4>
                                <p class="mt-1 line-clamp-2 break-words text-xs leading-relaxed text-slate-500">{{ video.descricao || 'Este vídeo ainda não possui descrição.' }}</p>
                            </div>
                            <span class="shrink-0 text-xs text-slate-500">{{ podeAssistir ? 'Assistir →' : 'Inscrição necessária' }}</span>
                        @if(podeAssistir)
                            </a>
                        @else
                            </div>
                        @end
                    </li>
                @else
                    <li class="p-6 text-sm text-slate-500 md:px-8">Este curso ainda não possui vídeos.</li>
                @end
            </ol>
        </section>
    </section>
@end
