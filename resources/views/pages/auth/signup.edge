<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cadastro</title>
    @vite(['resources/css/signup.css'])
</head>
<body>
    <main class="signup">
        <form class="signup__card" method="POST" action="/signup">
            {{csrfField()}}
            <h1>Cadastre-se</h1>
            <p>Conclua seu cadastro</p>

            @if(flashMessages.has('error'))
             <p class="signup__error">{{ flashMessages.get('error') }}</p>
            @end

            <label for="fullName">Nome</label>
            <input type="text" name="fullName" id="fullName" value="{{old('fullName') || ''}}" autocomplete="name">
            @if(flashMessages.has('inputErrorsBag.fullName'))
             <p class="signup__error">{{ flashMessages.get('inputErrorsBag.fullName')[0] }}</p>
            @end

            <label for="email">E-mail</label>
            <input type="email" name="email" id="email" value="{{old('email') || ''}}" autocomplete="email" required>
            @if(flashMessages.has('inputErrorsBag.email'))
             <p class="signup__error">{{ flashMessages.get('inputErrorsBag.email')[0] }}</p>
            @end

            <label for="password">Senha</label>
            <input type="password" name="password" id="password" autocomplete="new-password" required>
            @if(flashMessages.has('inputErrorsBag.password'))
             <p class="signup__error">{{ flashMessages.get('inputErrorsBag.password')[0] }}</p>
            @end

            <label for="confirmar__senha">Confirmar senha</label>
            <input type="password" name="passwordConfirmation" id="confirmar__senha" autocomplete="new-password" required>
            @if(flashMessages.has('inputErrorsBag.passwordConfirmation'))
             <p class="signup__error">{{ flashMessages.get('inputErrorsBag.passwordConfirmation')[0] }}</p>
            @end

            <button class="signup__button" type="submit">Cadastrar</button>
            <p class="login__foot">Já tem cadastro? <a href="/login">Entrar</a></p>
        </form>
    </main>
</body>
</html>
