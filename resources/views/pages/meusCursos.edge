@layouts.painel()
    <section>
        <div class="flex flex-row justify-between mt-10">
            <h2 class="text-2xl font-semibold text-slate-900">Meus Cursos</h2>
            <a href="/cursos/criar" class="inline-flex items-center justify-center px-5 py-3 bg-black rounded-2xl text-white font-semibold hover:bg-zinc-800 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-zinc-900">Criar curso</a>
        </div>

        <div class="grid grid-cols-1 gap-6 mt-8 mb-10 md:grid-cols-2 xl:grid-cols-3">
            @each(curso in cursos)
                <article class="overflow-hidden rounded-2xl bg-white shadow-sm">
                    <a href="/cursos/{{ curso.id }}" class="block h-full hover:bg-slate-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-zinc-900" aria-label="Ver detalhes do curso {{ curso.name }}">
                    @if(curso.caminhoCapa)
                        <img
                            src="{{ curso.caminhoCapa }}"
                            alt="Capa do curso {{ curso.name }}"
                            class="w-full aspect-video object-cover"
                            loading="lazy"
                        >
                    @end
                    <div class="p-5">
                        <h3 class="text-lg font-semibold text-slate-900">{{ curso.name }}</h3>
                        <p class="mt-2 text-sm text-slate-600">
                            {{ curso.descricao || 'Este curso ainda não possui descrição.' }}
                        </p>
                    </div>
                    </a>
                </article>
            @else
                <p class="text-slate-600">Você ainda não criou nenhum curso.</p>
            @end
        </div>
    </section>
@end
