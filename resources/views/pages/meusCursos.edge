@layouts.painel()
    <section>
        <div class="flex flex-row justify-between mt-10">
            <h2 class="text-2xl font-semibold text-slate-900">Meus Cursos</h2>
            <button class="max-w-40 p-4 bg-black rounded-2xl text-white font-semibold" onclick="document.getElementById('modal-criar-curso').showModal()">Criar Cursos</button>

            <dialog id="modal-criar-curso" class="m-auto text-center max-w-100 w-full  bg-white rounded-xl p-8">
                <form method="POST" action="/courses">
                    {{csrfField()}}
                    <h1 class="text-2xl font-semibold tex">Curso</h1>
                    <div class="w-full flex flex-col gap-5 mt-5 ">
                        <div class="flex flex-col items">
                            <label class="font-semibold" for="Nome_curso">Nome do curso</label>
                            <input type="text" name="Nome_curso" id="Nome_curso" class="m-auto border-slate-100 shadow-md px-2 py-1 max-w-100 bg-slate-200 rounded-2xl" placeholder="EX:Html e Css">
                        </div>  
                        <div class="flex flex-row justify-center w-full gap-2 mt-8">
                            <button type="submit" class="w-30 py-1 font-semibold  rounded-3xl border-0 border-slate-400 bg-[#dbffb6] hover:bg-[#a2ff45] ">Salvar</button>
                            <button type="button" onclick="document.getElementById('modal-criar-curso').close()" class="w-30 py-1 font-semibold  rounded-3xl border-0 border-slate-400 bg-[#ffb6b6] hover:bg-[#ff3030] ">Cancelar</button>
                        </div>
                    </div>
                </form>
                
            </dialog>
        </div>
    </section>
@end