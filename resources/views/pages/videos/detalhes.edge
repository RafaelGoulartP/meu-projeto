@layouts.painel()
    <section class="w-full max-w-5xl mx-auto pb-12" aria-labelledby="titulo-video">
        <a href="/cursos/{{ curso.id }}" class="inline-flex items-center gap-2 text-sm font-semibold text-slate-600 hover:text-slate-900">
            <span aria-hidden="true">←</span> Voltar para o curso
        </a>

        <div class="mt-7 mb-6">
            <p class="text-xs font-semibold uppercase tracking-widest text-[#657c4b]">{{ curso.name }}</p>
            <h2 id="titulo-video" class="mt-3 text-3xl font-semibold tracking-tight break-words text-slate-900">{{ video.name }}</h2>
        </div>

        <div class="overflow-hidden rounded-2xl bg-zinc-900 shadow-sm">
            @if(video.caminhoVideo)
                <video class="aspect-video w-full" controls playsinline preload="metadata" poster="{{ curso.caminhoCapa || '' }}" aria-label="{{ video.name }}">
                    <source src="{{ video.caminhoVideo }}">
                    Seu navegador não suporta a reprodução de vídeos.
                </video>
            @else
                <p class="px-6 py-16 text-center text-sm text-zinc-300">O arquivo deste vídeo ainda não está disponível.</p>
            @end
        </div>

        <article class="mt-6 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm md:p-8">
            <h3 class="font-semibold text-slate-900">Sobre esta aula</h3>
            <p class="mt-3 whitespace-pre-line break-words text-sm leading-relaxed text-slate-600">{{ video.descricao || 'Este vídeo ainda não possui descrição.' }}</p>
        </article>
    </section>
@end
