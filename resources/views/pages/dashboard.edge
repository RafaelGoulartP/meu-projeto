@layouts.painel()
    <section class="w-full max-w-6xl mx-auto pb-12" aria-labelledby="titulo-inscricoes">
        <div class="mb-8">
            <p class="text-xs font-semibold uppercase tracking-widest text-[#657c4b]">Seu espaço de aprendizado</p>
            <h2 id="titulo-inscricoes" class="mt-2 text-3xl font-semibold tracking-tight text-slate-900">Inscrições</h2>
            <p class="mt-3 text-sm text-slate-600">Acesse os seus cursos e descubra o que aprender a seguir.</p>
        </div>

        <form method="GET" action="/dashboard#explorar" class="mb-10 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
            <label for="busca" class="block text-sm font-semibold text-slate-800">O que você quer aprender?</label>
            <div class="mt-3 flex flex-col gap-3 sm:flex-row">
                <input type="search" id="busca" name="busca" value="{{ busca }}" maxlength="100" placeholder="Busque cursos pelo nome" class="min-w-0 flex-1 rounded-xl border border-slate-300 px-4 py-3 text-sm focus:border-[#7f9b60] focus:outline-2 focus:outline-[#d9efb5]">
                <button type="submit" class="cursor-pointer rounded-xl bg-zinc-900 px-6 py-3 text-sm font-semibold text-white hover:bg-zinc-700">Buscar cursos</button>
            </div>
        </form>

        <section aria-labelledby="titulo-andamento">
            <div class="mb-5 flex items-center gap-3">
                <h3 id="titulo-andamento" class="text-xl font-semibold text-slate-900">Em andamento</h3>
                <span class="rounded-md bg-[#e5edda] px-2 py-1 text-xs text-[#526e38]">{{ emAndamento.length }}</span>
            </div>
            <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
                @each(curso in emAndamento)
                    <article class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
                        <a href="/cursos/{{ curso.id }}" class="flex h-full flex-col hover:bg-slate-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-zinc-900">
                            @if(curso.caminhoCapa)
                                <img src="{{ curso.caminhoCapa }}" alt="Capa do curso {{ curso.name }}" class="aspect-video w-full object-cover" loading="lazy">
                            @else
                                <div class="flex aspect-video items-center justify-center bg-[#e5edda] text-sm text-[#526e38]">Sem imagem de capa</div>
                            @end
                            <div class="flex flex-1 flex-col p-5">
                                <p class="text-xs text-slate-500">Por {{ curso.responsavel?.fullName || 'Autor não informado' }}</p>
                                <h4 class="mt-2 break-words text-lg font-semibold text-slate-900">{{ curso.name }}</h4>
                                <p class="mt-2 text-xs text-slate-500">{{ curso.$extras.videos_count }} vídeos</p>
                                <span class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-[#526e38]">Acessar curso <span aria-hidden="true">→</span></span>
                            </div>
                        </a>
                    </article>
                @else
                    <div class="rounded-2xl border border-dashed border-slate-300 p-7 md:col-span-2 xl:col-span-3">
                        <p class="font-semibold text-slate-800">Você ainda não está inscrito em nenhum curso.</p>
                        <p class="mt-2 text-sm text-slate-600">Encontre seu próximo aprendizado entre os cursos de outros criadores.</p>
                        <a href="#explorar" class="mt-4 inline-block text-sm font-semibold text-[#526e38] underline underline-offset-4">Explorar cursos</a>
                    </div>
                @end
            </div>
        </section>

        <section id="explorar" class="mt-12 scroll-mt-6" aria-labelledby="titulo-explorar">
            <div class="mb-5 flex flex-wrap items-center justify-between gap-3">
                <div>
                    <h3 id="titulo-explorar" class="text-xl font-semibold text-slate-900">Explorar cursos</h3>
                    <p class="mt-2 text-sm text-slate-500">{{ busca ? 'Resultados para “' + busca + '”' : 'Cursos de outros usuários disponíveis para inscrição.' }}</p>
                </div>
                @if(busca)
                    <a href="/dashboard#explorar" class="text-sm font-semibold text-slate-600 underline underline-offset-4">Limpar busca</a>
                @end
            </div>
            <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
                @each(curso in explorar)
                    <article class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
                        <a href="/explorar/cursos/{{ curso.id }}" class="flex h-full flex-col hover:bg-slate-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-zinc-900">
                            @if(curso.caminhoCapa)
                                <img src="{{ curso.caminhoCapa }}" alt="Capa do curso {{ curso.name }}" class="aspect-video w-full object-cover" loading="lazy">
                            @else
                                <div class="flex aspect-video items-center justify-center bg-[#e5edda] text-sm text-[#526e38]">Sem imagem de capa</div>
                            @end
                            <div class="flex flex-1 flex-col p-5">
                                <p class="text-xs text-slate-500">Por {{ curso.responsavel?.fullName || 'Autor não informado' }}</p>
                                <h4 class="mt-2 break-words text-lg font-semibold text-slate-900">{{ curso.name }}</h4>
                                <p class="mt-2 line-clamp-2 break-words text-sm text-slate-600">{{ curso.descricao || 'Este curso ainda não possui descrição.' }}</p>
                                <p class="mt-3 text-xs text-slate-500">{{ curso.$extras.videos_count }} vídeos</p>
                                <span class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-[#526e38]">Ver curso <span aria-hidden="true">→</span></span>
                            </div>
                        </a>
                    </article>
                @else
                    <div class="rounded-2xl border border-dashed border-slate-300 p-7 text-sm text-slate-600 md:col-span-2 xl:col-span-3">
                        {{ busca ? 'Nenhum curso encontrado. Tente outro nome.' : 'Não há novos cursos disponíveis para inscrição no momento.' }}
                    </div>
                @end
            </div>
        </section>
    </section>
@end
